{
  "name": "spec-gate",
  "version": "0.0.1",
  "description": "A gate that refuses to let an AI agent start on an underspecified request, and a committed record of what was missing.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedramMadani/spec-gate.git"
  },
