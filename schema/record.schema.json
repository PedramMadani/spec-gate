{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PedramMadani/spec-gate/schema/record.schema.json",
  "title": "spec-gate decision record",
  "description": "The artifact. What was asked, what was missing, what was assumed, and who authorised proceeding.",
  "type": "object",
  "required": ["schema_version", "id", "created_at", "request", "profile", "threshold",
               "sufficiency", "dimensions", "scorer", "decision"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "description": "Stable id, also the record filename stem."},
    "created_at": {"type": "string", "format": "date-time"},
    "request": {"type": "string", "description": "The request as received, verbatim."},
    "caller": {"type": "object", "additionalProperties": true,
               "properties": {"client": {"type": "string"}, "repo": {"type": "string"}, "ref": {"type": "string"}}},
    "profile": {
      "type": "object", "required": ["id", "version", "source"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "version": {"type": "string"},
                     "source": {"type": "string", "description": "Config file that selected this profile."}}
    },
    "threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "sufficiency": {"type": "number", "minimum": 0, "maximum": 1},
    "dimensions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "coverage", "method"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "coverage": {"enum": [0, 0.4, 0.7, 1]},
          "method": {"enum": ["deterministic", "model"], "description": "How this coverage was established."},
          "evidence": {"type": ["string", "null"], "description": "Why that score. Never omit on a non-zero score."},
          "questions": {
            "type": "array",
            "items": {"type": "object", "required": ["ask"], "additionalProperties": false,
                      "properties": {"ask": {"type": "string"},
                                     "answer": {"type": ["string", "null"]},
                                     "answered_by": {"type": ["string", "null"]}}}
          }
        }
      }
    },
    "constraints": {"type": "array", "items": {"type": "string"},
                    "description": "Established during the exchange, binding on the work."},
    "assumptions": {"type": "array", "items": {"type": "string"},
                    "description": "Not established. Carried anyway, and visible because of this list."},
    "scorer": {
      "type": "object", "required": ["type"], "additionalProperties": false,
      "properties": {
        "type": {"enum": ["sampling", "external", "deterministic-only"]},
        "model": {"type": ["string", "null"]},
        "independent": {"type": "boolean",
                        "description": "False when the model being gated also scored the request."}
      }
    },
    "decision": {
      "type": "object", "required": ["verdict"], "additionalProperties": false,
      "properties": {
        "verdict": {"enum": ["proceed", "block", "override"]},
        "override": {
          "type": "object", "required": ["reason", "by", "at"], "additionalProperties": false,
          "properties": {"reason": {"type": "string", "minLength": 1},
                         "by": {"type": "string"}, "at": {"type": "string", "format": "date-time"}}
        }
      },
      "allOf": [{"if": {"properties": {"verdict": {"const": "override"}}},
                 "then": {"required": ["override"]}}]
    },
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$",
             "description": "Content hash of this record with the hash field removed."}
  }
}
